package sortpom.wrapper.operation;

import org.dom4j.Element;
import org.dom4j.Node;
import sortpom.wrapper.content.Wrapper;

/**
 * Creates wrappers around xml fragments.
 *
 * @author Bjorn Ekryd
 */
@org.checkerframework.framework.qual.AnnotatedFor("org.checkerframework.checker.index.inequality.LessThanChecker")
public interface WrapperFactory {

    /**
     * Creates wrapper around a root element.
     */
    @org.checkerframework.dataflow.qual.Impure
     HierarchyRootWrapper createFromRootElement( WrapperFactory this,  Element rootElement);

    /**
     * Creates wrapper around xml content.
     */
    @org.checkerframework.dataflow.qual.Impure
    <T extends Node>  Wrapper<T> create( WrapperFactory this, T content);
}
