package sortpom.util;

import java.io.StringWriter;
import java.io.Writer;

/**
 * Makes sure that all line endings are written in the same way. Keeps a buffer which is flushed
 * when newline is encountered. Removes the final trailing newline by delaying it.
 *
 * @author Bjorn
 */
@org.checkerframework.framework.qual.AnnotatedFor("org.checkerframework.checker.index.searchindex.SearchIndexChecker")
public class StringLineSeparatorWriter extends Writer {

    private static final   char NEWLINE = '\n';

    private final  String lineSeparator;

    private   boolean wasNewLine = false;

    private final  StringBuilder lineBuffer = new StringBuilder();

    private final  StringWriter out;

    @org.checkerframework.dataflow.qual.Impure
    public StringLineSeparatorWriter( StringWriter out,  String lineSeparator) {
        this.out = out;
        this.lineSeparator = lineSeparator;
    }

    @org.checkerframework.dataflow.qual.Impure
    public void write( StringLineSeparatorWriter this,  String str) {
        var chars = str.toCharArray();
        for (var ch : chars) {
            writeOneCharacter(ch);
        }
    }

    @org.checkerframework.dataflow.qual.Impure
    public void write( StringLineSeparatorWriter this,   int c) {
        writeOneCharacter((char) c);
    }

    @org.checkerframework.dataflow.qual.SideEffectFree
    public void write( StringLineSeparatorWriter this,   char  [] cb,   int off,   int len) {
        throw new UnsupportedOperationException();
    }

    @org.checkerframework.dataflow.qual.Impure
    public void close( StringLineSeparatorWriter this) {
        writeCharacterBuffer();
    }

    @org.checkerframework.dataflow.qual.Impure
    private void writeOneCharacter( StringLineSeparatorWriter this,   char ch) {
        writeDelayedNewline();
        if (ch == NEWLINE) {
            writeCharacterBuffer();
            wasNewLine = true;
        } else {
            lineBuffer.append(ch);
        }
    }

    @org.checkerframework.dataflow.qual.Impure
    public void writeDelayedNewline( StringLineSeparatorWriter this) {
        if (wasNewLine) {
            writeLineSeparator();
            wasNewLine = false;
        }
    }

    @org.checkerframework.dataflow.qual.Impure
    private void writeCharacterBuffer( StringLineSeparatorWriter this) {
        out.write(lineBuffer.toString());
        clearLineBuffer();
    }

    @org.checkerframework.dataflow.qual.Impure
    private void writeLineSeparator( StringLineSeparatorWriter this) {
        out.write(lineSeparator);
    }

    /**
     * Remove everything that has happened since last line break. Used to clear empty lines in the XML
     */
    @org.checkerframework.dataflow.qual.Impure
    public void clearLineBuffer( StringLineSeparatorWriter this) {
        lineBuffer.delete(0, lineBuffer.length());
    }

    @org.checkerframework.dataflow.qual.Impure
    public  String toString( StringLineSeparatorWriter this) {
        writeCharacterBuffer();
        return out.toString();
    }

    /**
     * Nope, no manual flushing
     */
    @org.checkerframework.dataflow.qual.SideEffectFree
    public void flush( StringLineSeparatorWriter this) {
        throw new UnsupportedOperationException();
    }
}
